# uv run --env-file .env avatar-runtime serve
AVATAR_DATA_DIR=var/avatar
# Separate upstream Python 3.10 + CUDA environment, shared by CLI/API generation.
SKYREELS_REPO=vendor/SkyReels-V2
SKYREELS_PYTHON=vendor/SkyReels-V2/.venv/bin/python
SKYREELS_MODEL=models/skyreels-v2-df-1.3b-540p
# Total preflight + generation timeout; positive finite seconds.
AVATAR_GENERATION_TIMEOUT_SECONDS=1800
