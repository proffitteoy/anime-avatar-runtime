# uv run --env-file .env avatar-runtime serve
AVATAR_DATA_DIR=var/avatar
# Separate upstream Python 3.10 + CUDA environment, shared by CLI/API generation.
SKYREELS_REPO=vendor/SkyReels-V2
SKYREELS_PYTHON=vendor/SkyReels-V2/.venv/bin/python
SKYREELS_MODEL=models/skyreels-v2-df-1.3b-540p
# int8-quantize transformer weights; required for the 8GB memory baseline. The
# backend subprocess reads this at load time; run.json records its effective value.
QUANTIZE_INT8=1
# Total preflight + generation timeout; positive finite seconds.
AVATAR_GENERATION_TIMEOUT_SECONDS=1800
# Separate Python 3.12 CPU observer environment; leave unset until installed.
# Windows: .tools/observer-env/Scripts/python.exe
# AVATAR_OBSERVER_PYTHON=.tools/observer-env/bin/python
AVATAR_OBSERVER_MODELS=models/observers
AVATAR_OBSERVATION_TIMEOUT_SECONDS=600
