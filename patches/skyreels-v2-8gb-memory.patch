+class LinearInt8BF16(nn.Module):
+    """int8 weight storage; dequantizes to bf16 activation dtype on forward."""
+    def __init__(self, weight_int8, scale, bias=None):
+        super().__init__()
+        self.register_buffer("weight_int8", weight_int8)
+        self.register_buffer("scale", scale)
+        if bias is not None:
+            self.register_buffer("bias", bias)
+        else:
+            self.bias = None
+        self.in_features = weight_int8.shape[1]
+        self.out_features = weight_int8.shape[0]
+
+    @property
+    def weight(self):
+        return self.weight_int8.to(torch.bfloat16) * self.scale.to(torch.bfloat16)
+
+    def forward(self, x):
+        w = self.weight_int8.to(x.dtype) * self.scale.to(x.dtype)
+        bias = self.bias.to(x.dtype) if self.bias is not None else None
+        return torch.nn.functional.linear(x, w, bias)
+
+
+def _quantize_linear_bf16(linear):
+    w = linear.weight.data.float()
+    scale = (w.abs().max() / 127.0).clamp(min=1e-8)
+    w_int8 = (w / scale).round().clamp(-128, 127).to(torch.int8)
+    return LinearInt8BF16(w_int8, scale, linear.bias)
+
