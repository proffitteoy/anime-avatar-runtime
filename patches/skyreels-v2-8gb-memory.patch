new file mode 100644
index 0000000..38f8069
--- /dev/null
+++ b/skyreels_v2_infer/modules/profiling.py
@@ -0,0 +1,30 @@
+# Opt-in CUDA event profiling. Zero overhead (no sync, no print) unless
+# SKYREELS_PROFILE=1 is set in the environment.
+
+import os
+
+PROFILING = os.environ.get("SKYREELS_PROFILE") == "1"
+
+
+def record():
+    """Record a CUDA event on the current stream, or None when profiling is off."""
+    if not PROFILING:
+        return None
+    import torch
+
+    ev = torch.cuda.Event(enable_timing=True)
+    ev.record()
+    return ev
+
+
+def report(name, start, end=None):
+    """Print elapsed ms between two events (end defaults to a new event now)."""
+    if not PROFILING or start is None:
+        return
+    import torch
+
+    if end is None:
+        end = torch.cuda.Event(enable_timing=True)
+        end.record()
+    torch.cuda.synchronize()
+    print(f"[PROFILE:{name}] {start.elapsed_time(end):.1f}ms", flush=True)
